{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "allowImportingTsExtensions": false,
    "allowJs": true
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__", "src/**/examples", "src/**/doc"]
}
