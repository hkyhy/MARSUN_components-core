      "block": true
    },
    {
      "title": "4. disabled",
      "description": "disabled 不可编辑",
      "component": "@/components/Editor/examples/RichTextDisabledDemo",
      "sourcePath": "@/components/Editor/examples/RichTextDisabledDemo/index.tsx"
    },
    {
      "title": "5. 只读",
      "description": "readOnly 只读展示",
