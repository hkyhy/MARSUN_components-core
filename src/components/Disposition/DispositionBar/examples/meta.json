      "sourcePath": "@/components/Disposition/DispositionBar/examples/StatusLoadingDemo/index.tsx"
    },
    {
      "title": "3. 仅状态",
      "description": "无 actions（如已关闭）",
      "component": "@/components/Disposition/DispositionBar/examples/StatusOnlyDemo",
      "sourcePath": "@/components/Disposition/DispositionBar/examples/StatusOnlyDemo/index.tsx"
    },
    {
      "title": "4. 自定义 label",
      "description": "label 覆盖默认「处置状态」",
      "component": "@/components/Disposition/DispositionBar/examples/CustomLabelDemo",
      "sourcePath": "@/components/Disposition/DispositionBar/examples/CustomLabelDemo/index.tsx"
    },
    {
      "title": "5. 自定义徽章",
      "description": "statusBadge 传 ReactNode（如 antd Tag）",
