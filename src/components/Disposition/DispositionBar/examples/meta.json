  "apiDoc": [
    {
      "componentName": "DispositionBarProps",
      "rows": [
        {
          "prop": "label",
          "desc": "左侧文案；有 lead 时不渲染",
          "type": "string",
          "defaultVal": "'处置状态'"
        },
        {
          "prop": "lead",
          "desc": "左侧预警摘要；有则不渲染「处置状态」label",
          "type": "ReactNode"
        },
        {
          "prop": "statusBadge",
          "desc": "状态徽章（string 或 ReactNode）；可与 lead 并存",
          "type": "ReactNode"
        },
        {
          "prop": "actions",
          "desc": "右侧操作区",
          "type": "ReactNode"
        },
        {
          "prop": "statusLoading",
          "desc": "true 时不渲染 actions",
          "type": "boolean"
        },
        {
          "prop": "className",
          "desc": "根节点额外 class（如业务侧 margin）",
          "type": "string"
        }
      ]
    }
  ]
}
